// Cloudflare Worker 配置 —— universe 是静态资源 + 一个极小的计数接口。
//
// 与 Photo_proj 的区别：那边有 Python 构建管线（依赖本地 7.6 GB 素材，
// CI 跑不了），所以 dist_pages/ 是本地构建好、提交进仓库的产物。
// universe **没有构建步骤** —— src/ 里就是最终产物，直接部署。
// 所以这里 assets.directory 指向 ./src，不需要任何 build command。
//
// ⚠️ name 必须和 Cloudflare 控制台里的 Worker 名完全一致，否则构建直接失败。
//
// ★ 2026-10-10 变化：加了 `main`（worker/index.js）。
//   此前是**纯静态 Worker**（无服务端代码）。作者要在左下角放真实的访客记录，
//   而真实计数必须有持久化存储 —— 前端算不出来。所以加了一个只处理
//   `/api/visits` 的入口，其余路径照旧走静态资源。
//   家族铁律「零第三方依赖」仍然成立：计数用本账号的 KV，没引公共计数服务。
{
  "name": "qxt1me-universe",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-27",

  "assets": {
    "directory": "./src",

    // ⚠️ 关键：不配这条，/api/* 会先落到静态资源兜底上，
    //    返回 404 页而不是 JSON。run_worker_first 让这些路径先走代码。
    "run_worker_first": ["/api/*"],

    // 找不到路径时用 404.html（与 index.html 同级）。
    // 不设这条的话，不存在的路径会落到 Cloudflare 的默认英文 404 页。
    "not_found_handling": "404-page"
  },

  // 访客计数的持久化存储（2026-10-10 新建）
  "kv_namespaces": [
    { "binding": "UV_VISITS", "id": "c6631cf23aeb427f97f2c22d84eb5d0b" }
  ],

  // 保留 *.workers.dev 地址当预览入口。
  "workers_dev": true,
  "preview_urls": true

  // ── 自定义域名 ──────────────────────────────────────────────
  // 两种做法，二选一（推荐第一种，跟 blog 一样在控制台点）：
  //
  // ① 控制台：Worker → 设置 → 域和路由 → 添加 → 自定义域
  //      填 universe.qxt1me.dpdns.org（或根域 qxt1me.dpdns.org）
  //
  // ② 写在这里（注意：控制台里已有同名绑定时，以控制台为准）：
  // "routes": [
  //   { "pattern": "universe.qxt1me.dpdns.org", "custom_domain": true }
  // ]
}
